  "structure": {
    "type": "App",
    "description": "Fruit Selector is an app that allows users to choose multiple fruits from a list according to their preferences.",
    "screens": [
      {
        "name": "Fruit Selection Page",
        "description": "Users can browse a visually appealing list of fruits, each displayed with its name and an image. The user can select or deselect multiple fruits using checkboxes or toggles next to each fruit. There is also a search bar to quickly find specific fruits. At the bottom, there is a button to confirm their selection. The user sees the app name at the top, and their current selections are summarized in a small area."
      }
    ]
