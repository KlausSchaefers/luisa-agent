        "screens": [
          {
            "name": "Welcome Screen",
            "description": "The landing page displays the app name 'Banana Encyclopedia' with an attractive hero image of bananas. Users will see a brief introduction about what the app offers, including access to scientific facts and recipes. There are visual navigation cards or buttons leading to the 'About Bananas' and 'Recipes' sections. The screen has a welcoming and colorful design to engage users immediately."
          },
          {
            "name": "About Bananas Screen",
            "description": "This page presents comprehensive scientific facts about bananas. Users will see information organized in sections including: botanical classification, nutritional content (vitamins, minerals, calories), health benefits, origin and cultivation history, different banana varieties, and interesting scientific facts. The information is displayed in an easy-to-read format with headings, bullet points, and possibly icons or images to illustrate key facts. Users can scroll through the content to learn all about bananas from a scientific perspective."
          },
          {
            "name": "Recipes Screen",
            "description": "This page showcases a collection of banana recipes. Users will see a list or grid of recipe cards, each displaying a recipe name, a thumbnail image of the finished dish, preparation time, and difficulty level. Each recipe card can be tapped to view full details including ingredients list, step-by-step instructions, and cooking tips. The page includes various recipe categories such as desserts (banana bread, smoothies, pancakes), snacks, and healthy options. Users can browse through all available banana recipes to find inspiration for cooking."
          }
        ]
      }
    ]
  }
